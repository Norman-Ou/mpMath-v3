{
    "name": "mpMath v3",
    "version": "0.3.0",
    "description": "微信公众平台公式支持：使用 LaTeX 编辑 SVG 公式，适配新版 Chrome Manifest V3。",
    "permissions": ["declarativeContent"],
    "background": {
        "service_worker": "assets/js/background.js",
        "type": "module"
    },
    "action": {
        "default_icon": {
            "16": "assets/images/mpMath_logo16.png",
            "32": "assets/images/mpMath_logo32.png",
            "48": "assets/images/mpMath_logo48.png",
            "128": "assets/images/mpMath_logo128.png"
        }
    },
    "icons": {
        "16": "assets/images/mpMath_logo16.png",
        "32": "assets/images/mpMath_logo32.png",
        "48": "assets/images/mpMath_logo48.png",
        "128": "assets/images/mpMath_logo128.png"
    },
    "content_scripts": [{
        "matches": [
            "*://mp.weixin.qq.com/*"
        ],
        "js": [
            "assets/js/content-script.js"
        ],
        "css": [
            "assets/css/mpMath.css"
        ],
        "run_at": "document_idle"
    }, {
        "matches": ["*://mp.weixin.qq.com/*"],
        "js": ["assets/js/mpm-inject.js"],
        "world": "MAIN",
        "run_at": "document_idle"
    }],
    "web_accessible_resources": [
        {
            "resources": [
                "pages/popup.html"
            ],
            "matches": ["*://mp.weixin.qq.com/*"]
        }
    ],
    "manifest_version": 3
}
